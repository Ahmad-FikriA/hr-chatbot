# Copy this file to `.env` and fill in ONE provider's key.
#   cp .env.example .env

PORT=3000

# ─────────────────────────────────────────────────────────────
# Choose ONE LLM provider (both are OpenAI-compatible & free).
# ─────────────────────────────────────────────────────────────

# Option A — Groq  (fast, reliable free tier; key: https://console.groq.com/keys)
LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
CHAT_MODEL=llama-3.3-70b-versatile

# Option B — OpenRouter (free models; key: https://openrouter.ai/keys)
# Comment out Option A above and uncomment these three:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=
# CHAT_MODEL=google/gemma-4-31b-it:free

# Optional tuning (defaults live in backend/config.js)
# TOP_K=3
# MIN_SCORE=0.3
